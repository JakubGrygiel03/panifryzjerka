{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "panifryzjerka.vercel.app" }],
      "destination": "https://panifryzjerka.pl/:path*",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 16 * * *"
    }
  ]
}
