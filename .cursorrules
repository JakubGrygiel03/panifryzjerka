## 🗄️ Database Schema & Security (Supabase PostgreSQL)

```sql
create extension if not exists "uuid-ossp";

-- Typy domenowe
create type appointment_status as enum ('confirmed', 'cancelled', 'completed', 'no_show');

-- 1. Tenants (Multi-tenant gotowy do wdrożenia w kolejnych salonach)
create table tenants (
  id uuid default gen_random_uuid() primary key,
  name text not null,
  slug text unique not null, -- 'panifryzjerka'
  phone text not null,
  email text not null,
  slot_interval_minutes int default 15 not null,
  created_at timestamptz default now() not null
);

-- 2. Personel / Stylistki
create table staff_members (
  id uuid default gen_random_uuid() primary key,
  tenant_id uuid references tenants(id) on delete cascade not null,
  name text not null, -- 'Iryna', 'Bella'
  role text default 'Stylistka fryzur' not null,
  avatar_url text,
  is_active boolean default true not null
);

-- 3. Usługi w systemie rezerwacji
create table services (
  id uuid default gen_random_uuid() primary key,
  tenant_id uuid references tenants(id) on delete cascade not null,
  name text not null, -- '#szycieSiwizny', 'Strzyżenie damskie', 'Afroloki'
  category text not null,
  duration_minutes int not null,
  buffer_time_minutes int default 15 not null,
  price_min_cents int not null,
  price_max_cents int,
  is_active boolean default true not null
);

-- 4. Powiązanie Stylistka <-> Usługa
create table staff_services (
  staff_id uuid references staff_members(id) on delete cascade not null,
  service_id uuid references services(id) on delete cascade not null,
  primary key (staff_id, service_id)
);

-- 5. Harmonogram godzin pracy
create table working_hours (
  id uuid default gen_random_uuid() primary key,
  staff_id uuid references staff_members(id) on delete cascade not null,
  day_of_week int not null check (day_of_week between 0 and 6), -- 0=Niedziela, 1=Poniedziałek
  start_time time not null, -- '09:00'
  end_time time not null    -- '19:00'
);

-- 6. Urlopy i nieobecności
create table time_offs (
  id uuid default gen_random_uuid() primary key,
  staff_id uuid references staff_members(id) on delete cascade not null,
  start_date timestamptz not null,
  end_date timestamptz not null,
  reason text
);

-- 7. Wizyty i Rezerwacje
create table appointments (
  id uuid default gen_random_uuid() primary key,
  tenant_id uuid references tenants(id) on delete cascade not null,
  service_id uuid references services(id) not null,
  staff_id uuid references staff_members(id) not null,
  customer_name text not null,
  customer_phone text not null,
  customer_email text,
  notes text,
  start_time timestamptz not null,
  end_time timestamptz not null,
  status appointment_status default 'confirmed' not null,
  created_at timestamptz default now() not null
);

-- Indeksy pod szybkie wyszukiwanie wolnych slotów
create index idx_appointments_lookup on appointments (staff_id, start_time, end_time);
create index idx_services_tenant on services (tenant_id);

-- Row Level Security (RLS)
alter table tenants enable row level security;
alter table staff_members enable row level security;
alter table services enable row level security;
alter table staff_services enable row level security;
alter table working_hours enable row level security;
alter table time_offs enable row level security;
alter table appointments enable row level security;

-- Publiczne Polityki Odczytu
create policy "Public read services" on services for select using (is_active = true);
create policy "Public read staff" on staff_members for select using (is_active = true);
create policy "Public read working hours" on working_hours for select using (true);
create policy "Public read appointments for slots" on appointments for select using (true);

-- Publiczne Tworzenie Wizyty
create policy "Public insert appointment" on appointments for insert with check (true);

-- Dostęp Administracyjny dla Zalogowanego Personelu
create policy "Staff manage appointments" on appointments for all using (auth.role() = 'authenticated');
create policy "Staff manage hours" on working_hours for all using (auth.role() = 'authenticated');
create policy "Staff manage time offs" on time_offs for all using (auth.role() = 'authenticated');

